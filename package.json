{
  "name": "read-the-room",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time multiplayer social prediction game built with React and Cloudflare Workers.",
  "author": "Shreyas Wani",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreyas0917/Read-the-Room.git"
  },
  "homepage": "https://read-the-room.read-the-room.workers.dev",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "node tests/integration/run.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
